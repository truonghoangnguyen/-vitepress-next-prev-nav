{
  "name": "vitepress-next-prev-nav",
  "version": "0.1.0",
  "description": "A VitePress plugin to automatically generate prev/next navigation links from custom article lists, featuring a gennav CLI and custom UI component.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": "./src/theme/index.js"
  },
  "bin": {
    "gennav": "./dist/bin/gennav.js"
  },
  "files": [
    "dist",
    "src/theme",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "keywords": [
    "vitepress",
    "vite-plugin",
    "vue",
    "next-prev",
    "navigation",
    "docs"
  ],
  "peerDependencies": {
    "vitepress": "^1.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitepress": "^1.5.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
