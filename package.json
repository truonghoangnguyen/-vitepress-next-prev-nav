{
  "name": "vitepress-next-prev-nav",
  "version": "0.1.1",
  "description": "A VitePress plugin to automatically generate prev/next navigation links from custom article lists, featuring a gennav CLI and custom UI component.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": "./src/theme/index.js"
  },
  "bin": {
    "gennav": "./dist/bin/gennav.js"
  },
  "files": [
    "dist",
    "src/theme",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "keywords": [
    "vitepress",
    "vite-plugin",
    "vue",
    "next-prev",
    "navigation",
    "docs"
  ],
  "peerDependencies": {
    "vitepress": "^1.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.41"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
